# AI Video Pipeline Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Stage 1-2: Topic Research & Filtering
# ==========================================

# Feedly API (for RSS aggregation)
FEEDLY_ACCESS_TOKEN=your_feedly_token_here

# Make.com webhook URL (receives filtered articles)
MAKE_WEBHOOK_URL=https://hook.make.com/your_webhook_id

# ==========================================
# Stage 2: AI Topic Scoring
# ==========================================

# OpenAI API (for topic scoring)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Scoring threshold (topics below this are rejected)
TOPIC_SCORE_THRESHOLD=7

# ==========================================
# Stage 3: Research Automation
# ==========================================

# Perplexity API (for deep research briefs)
PERPLEXITY_API_KEY=pplx-your_key_here

# ==========================================
# Stage 4: Script Generation
# ==========================================

# Claude API (optional, alternative to OpenAI for scripts)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ==========================================
# Stage 5: Synthetic Media
# ==========================================

# ElevenLabs (voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id

# HeyGen (avatar video generation)
HEYGEN_API_KEY=your_heygen_key_here
HEYGEN_AVATAR_ID=your_avatar_id

# Hedra (free alternative for avatars)
HEDRA_API_KEY=your_hedra_key_here

# Kling AI / Seedance (B-roll generation)
KLING_API_KEY=your_kling_key_here

# ==========================================
# Stage 6: Publishing
# ==========================================

# YouTube Data API
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your_linkedin_token

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_account_id

# ==========================================
# Notifications
# ==========================================

# Slack (for topic alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# Data Storage
# ==========================================

# Airtable (topic queue database)
AIRTABLE_API_KEY=your_airtable_key
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_NAME=Topic Queue

# ==========================================
# Local Processing
# ==========================================

# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# FFmpeg path (if not in system PATH)
FFMPEG_PATH=ffmpeg

# Output directory for generated videos
OUTPUT_DIR=./output

# ==========================================
# Cost Controls
# ==========================================

# Maximum API spend per day (USD)
DAILY_API_BUDGET=10.00

# Use local models for drafts (true/false)
USE_LOCAL_FOR_DRAFTS=true
